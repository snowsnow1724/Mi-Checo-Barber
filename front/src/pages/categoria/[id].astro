---
import type { Category } from '@/domain/catalog/Category'
import { getCategories, getCategoryById } from '@/infrastructure/container'
import Shop from '@/presentation/components/customer/Shop.astro'
import BaseLayout from '@/presentation/components/layout/BaseLayout.astro'

const { id } = Astro.params

let categories: Category[] = []
let category: Category | null = null
let error = ''

try {
  ;[categories, category] = await Promise.all([
    getCategories.execute(),
    getCategoryById.execute(id ?? ''),
  ])
} catch (err) {
  error = err instanceof Error ? err.message : 'Error de conexión.'
}

if (!error && !category) Astro.response.status = 404

if (!error && category && !Astro.locals.user) {
  Astro.response.headers.set(
    'Cache-Control',
    'public, s-maxage=30, stale-while-revalidate=300'
  )
} else {
  Astro.response.headers.set('Cache-Control', 'private, no-store')
}
---

<BaseLayout
  title={`${category?.name ?? 'Categoría'} | ChecoBarber`}
  description={category?.description || `Explora productos de ${category?.name ?? 'esta categoría'} en ChecoBarber.`}
>
  <Shop
    categories={categories}
    products={category?.products ?? []}
    activeCategoryId={id ?? null}
    error={error}
  />
</BaseLayout>