---

<a href="/carrito" class="inline-flex h-9 items-center justify-center gap-1.5 border border-border bg-background px-2.5 text-xs font-medium hover:bg-muted focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring">
  <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4">
    <path d="M3 3h2l2.2 10.1a2 2 0 0 0 2 1.6h7.6a2 2 0 0 0 1.9-1.4L20 7H6" />
    <circle cx="10" cy="19" r="1" />
    <circle cx="17" cy="19" r="1" />
  </svg>
  <span class="hidden sm:inline">Tu carrito</span>
  <span
    data-cart-count
    aria-label="Productos en el carrito"
    class="ml-1 rounded-full bg-secondary px-1.5"
  >0</span>
</a>

<script>
  const CART_KEY = 'checobarber-cart'

  function updateCount() {
    const badge = document.querySelector<HTMLElement>('[data-cart-count]')
    if (!badge) return

    let count = 0
    try {
      const saved = localStorage.getItem(CART_KEY)
      const items = saved ? JSON.parse(saved)?.state?.items : []
      if (Array.isArray(items)) {
        count = items.reduce((total, item) => {
          const quantity = Number(item?.quantity)
          return total + (Number.isFinite(quantity) && quantity > 0 ? quantity : 0)
        }, 0)
      }
    } catch (error) {
      console.warn('[carrito] No se pudo leer el contador guardado.', error)
    }

    badge.textContent = String(count)
  }

  updateCount()
  window.addEventListener('storage', updateCount)
  window.addEventListener('checobarber:cart-change', updateCount)
</script>
