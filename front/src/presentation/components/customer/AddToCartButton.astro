---
import type { CartProduct } from '@/domain/cart/Cart'

interface Props {
  product: CartProduct
}

const { product } = Astro.props
---

<div data-cart-action-root>
  <button
    type="button"
    data-add-to-cart
    data-product-id={product.id}
    data-product-name={product.name}
    data-product-price={product.price}
    data-product-img={product.img}
    aria-label={`Añadir ${product.name} al carrito`}
    class="inline-flex h-8 items-center justify-center gap-1.5 border border-border bg-background px-2.5 text-xs font-medium hover:bg-muted focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
  >
    Añadir
  </button>
  <span data-cart-status role="status" class="sr-only"></span>
</div>

<script>
  import './cartActions'
</script>
